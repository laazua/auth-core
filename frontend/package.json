{
  "name": "auth-core-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.ts,.js --fix",
    "lint:check": "eslint . --ext .vue,.ts,.js",
    "format": "prettier --write \"src/**/*.{vue,ts,js,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,json,css,md}\"",
    "stylelint": "stylelint \"src/**/*.{vue,css}\" --fix",
    "stylelint:check": "stylelint \"src/**/*.{vue,css}\""
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "element-plus": "^2.7.0",
    "axios": "^1.6.7",
    "@element-plus/icons-vue": "^2.3.1",
    "nprogress": "^0.2.0",
    "js-cookie": "^3.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "@vue/test-utils": "^2.4.5",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vitest": "^1.4.0",
    "@vitest/coverage-v8": "^1.4.0",
    "jsdom": "^24.0.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint-plugin-vue": "^9.22.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-recess-order": "^5.0.0",
    "stylelint-prettier": "^5.0.0",
    "unplugin-vue-components": "^0.26.0",
    "unplugin-auto-import": "^0.17.5",
    "sass": "^1.72.0",
    "@types/js-cookie": "^3.0.6",
    "@types/nprogress": "^0.2.3",
    "@types/node": "^20.11.24"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}